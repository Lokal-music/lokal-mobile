<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- An intentional abstract sleeve is shown only when a track has no
         accessible metadata cover. Never replace an available album cover. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#6E395C" android:centerColor="#3A284D"
                android:endColor="#1D2943" android:angle="45"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="30dp" android:height="30dp"/>
            <solid android:color="#77431B30"/>
            <stroke android:color="#78FFFFFF" android:width="1dp"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="9dp" android:height="9dp"/>
            <solid android:color="#EBD8E5"/>
        </shape>
    </item>
</layer-list>
