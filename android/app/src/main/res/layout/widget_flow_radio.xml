<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flow_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_3">
    <ImageView android:id="@+id/flow_cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/widget_default_art" android:alpha="0.35"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="14dp" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/flow_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FLOW / RADIO" android:textColor="#BFD7FF" android:textSize="11sp"
            android:fontFamily="@font/product_sans_bold"/>
        <TextView android:id="@+id/flow_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="16sp"
            android:fontFamily="@font/product_sans_bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/flow_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#D0FFFFFF" android:textSize="11sp"
            android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/flow_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                android:gravity="center" android:text="Play Flow" android:textColor="#FFFFFF"
                android:textSize="12sp" android:background="@drawable/widget_button_transport_active_bg"/>
            <TextView android:id="@+id/flow_shuffle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                android:layout_marginStart="6dp" android:gravity="center" android:text="New mix"
                android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/widget_button_transport_bg"/>
            <TextView android:id="@+id/flow_radio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                android:layout_marginStart="6dp" android:gravity="center" android:text="Radio"
                android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/widget_button_transport_bg"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>