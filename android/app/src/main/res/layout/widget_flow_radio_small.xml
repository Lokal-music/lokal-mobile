<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flow_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_3">
    <ImageView android:id="@+id/flow_cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/widget_art_placeholder" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="9dp" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/flow_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FLOW / RADIO" android:textColor="#BFD7FF" android:textSize="9sp"
            android:singleLine="true" android:fontFamily="@font/product_sans_bold"/>
        <TextView android:id="@+id/flow_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="#FFFFFF" android:textSize="13sp"
            android:fontFamily="@font/product_sans_bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/flow_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#D0FFFFFF" android:textSize="10sp"
            android:singleLine="true" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/flow_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
                android:gravity="center" android:text="Flow" android:textColor="#FFFFFF"
                android:textSize="10sp" android:background="@drawable/widget_button_transport_active_bg"/>
            <TextView android:id="@+id/flow_shuffle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
                android:layout_marginStart="3dp" android:gravity="center" android:text="Mix"
                android:textColor="#FFFFFF" android:textSize="10sp" android:background="@drawable/widget_button_transport_bg"/>
            <TextView android:id="@+id/flow_radio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
                android:layout_marginStart="3dp" android:gravity="center" android:text="Radio"
                android:textColor="#FFFFFF" android:textSize="10sp" android:background="@drawable/widget_button_transport_bg"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>